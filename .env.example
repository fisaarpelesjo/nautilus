# Binance API Keys
# Crie em: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Modo de operacao: paper (simulado) ou live (dinheiro real)
TRADING_MODE=paper
LIVE_TRADING_CONFIRMATION=

# Pares e timeframes
PAIRS=BTC/USDT,ETH/USDT,SOL/USDT
BLACKLIST_PAIRS=
TIMEFRAME=4h
MTF_TIMEFRAME=1d

# Selecao dinamica de pares
DYNAMIC_PAIRS_ENABLED=false
DYNAMIC_PAIRS_TOP_N=5
DYNAMIC_PAIRS_CANDIDATES=20
MIN_VOLUME_USDT=10000000
MAX_SPREAD_PCT=0.003
MIN_VOLATILITY_PCT=1.0

# Tamanho e limites de posicao
MAX_ORDER_SIZE_USDT=100.0
MAX_POSITIONS=5
MAX_SPREAD_PCT_ENTRY=0.005
MIN_ORDERBOOK_DEPTH_USDT=300.0
USE_LIMIT_ORDERS=false
LIMIT_ORDER_TIMEOUT_CYCLES=3

# Stop loss e take profit
STOP_LOSS_PCT=0.015
TAKE_PROFIT_PCT=0.06
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0

# Filtros da estrategia
EMA_FAST=9
EMA_SLOW=21
EMA_TREND=50
RSI_PERIOD=14
RSI_OVERSOLD=35
RSI_OVERBOUGHT=70
VOLUME_MA_PERIOD=20
VOLUME_MIN_RATIO=1.0
BB_PERIOD=20
BB_STD=2.0
PULLBACK_ENTRY_ENABLED=true
PULLBACK_RSI_MIN=45
PULLBACK_MAX_DISTANCE_PCT=0.01

# Controles operacionais
COOLDOWN_HOURS=4
DAILY_DRAWDOWN_LIMIT=0.05
WEEKLY_DRAWDOWN_LIMIT=0.10
MONTHLY_DRAWDOWN_LIMIT=0.20
MAX_CONSECUTIVE_LOSSES=3
DAILY_REPORT_HOUR=0

# Backtest
BACKTEST_FEE_RATE=0.001
BACKTEST_SLIPPAGE_PCT=0.0005

# Notificacoes via Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
