# Binance API Keys
# Crie em: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Modo de operação: paper (simulado) ou live (dinheiro real)
TRADING_MODE=paper
LIVE_TRADING_CONFIRMATION=

# Pares e timeframe
PAIRS=BTC/USDT,ETH/USDT,SOL/USDT
BLACKLIST_PAIRS=
TIMEFRAME=4h
DYNAMIC_PAIRS_ENABLED=false
DYNAMIC_PAIRS_TOP_N=5
DYNAMIC_PAIRS_CANDIDATES=20
MIN_VOLUME_USDT=10000000
MAX_SPREAD_PCT=0.003
MIN_VOLATILITY_PCT=1.0

# Valor máximo por operação em USDT
MAX_ORDER_SIZE_USDT=100.0

# Stop loss e take profit (percentual, ex: 0.02 = 2%)
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04

# Notificações via Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
