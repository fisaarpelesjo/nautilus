.env
# Qualquer variante do .env (backup, local, por-ambiente) carrega as mesmas
# chaves da Binance. Sem esta linha, .env.bak entra num git add -A -- foram
# encontrados 4 deles nao rastreados em 2026-09-01.
.env.*
!.env.example
logs/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.DS_Store

# claude code local config
.claude/

# runtime data
data/signals.csv
data/decisions.csv
data/trades.csv
data/performance_report.html
data/state.json
data/killswitch.json
data/ohlcv/
.coverage
reports/

# local research papers and full-text conversions
/*.pdf
